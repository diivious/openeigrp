#!/bin/bash
# Copyright (C) 2026 Donnie V. Savage
# Keep FRR's native daemon management; watchfrr is the foreground supervisor.
# FRR frrcommon.sh reads optional shell variables and positional arguments.
# It is not compatible with Bash nounset (set -u).
set -eo pipefail

# Docker Desktop can inherit an exceptionally high soft descriptor limit.
# FRR caps its internal event tables and warns at 100000. Reduce only the
# inherited soft limit (never raise a lower limit or change the hard limit).
soft_fd_limit="$(ulimit -Sn)"
if [[ "$soft_fd_limit" == unlimited ]] ||
   [[ "$soft_fd_limit" =~ ^[0-9]+$ && "$soft_fd_limit" -gt 65536 ]]; then
  ulimit -Sn 65536
fi

log_success_msg() { echo "$*"; }
log_warning_msg() { echo "$*" >&2; }
log_failure_msg() { echo "$*" >&2; }

[[ -r /etc/frr/daemons && -r /etc/frr/frr.conf ]] || {
  echo 'error: /etc/frr/daemons and frr.conf must both exist and be readable' >&2
  exit 1
}
# Existing /etc/frr volumes predate the bundled vtysh.conf.
# Fill in the standard default only when missing; never overwrite user config.
if [[ ! -e /etc/frr/vtysh.conf ]]; then
  install -o frr -g frrvty -m 0640 \
    /usr/share/frr/docker-vtysh.conf /etc/frr/vtysh.conf
fi
install -d -o frr -g frr -m 0775 /run/frr
# shellcheck source=/dev/null
source /usr/lib/frr/frrcommon.sh
read -r -a running_daemons <<< "$(daemon_list)"
for required in mgmtd zebra staticd; do
  if [[ " ${running_daemons[*]} " != *" $required "* ]]; then
    echo "error: FRR daemon $required is not enabled or not installed" >&2
    exit 1
  fi
done
if [[ " ${running_daemons[*]} " != *" eigrpd "* ]]; then
  echo 'warning: eigrpd is disabled; OpenEIGRP routing is unavailable (set eigrpd=yes in /etc/frr/daemons to enable it)' >&2
fi
exec /usr/lib/frr/watchfrr "${running_daemons[@]}"
