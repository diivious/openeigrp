[Unit]
Description=OpenEIGRP native Linux routing daemon
Documentation=man:openeigrpd(8) man:openeigrpd.conf(5)
After=network.target
ConditionPathExists=/etc/openeigrpd.conf

[Service]
Type=simple
User=openeigrp
Group=openeigrpctl
UMask=0007
RuntimeDirectory=openeigrpd
RuntimeDirectoryMode=0750
LoadCredential=openeigrpd.conf:/etc/openeigrpd.conf
ExecStartPre=/usr/bin/openeigrpd-config -t -f ${CREDENTIALS_DIRECTORY}/openeigrpd.conf
ExecStart=/usr/sbin/openeigrpd -f ${CREDENTIALS_DIRECTORY}/openeigrpd.conf
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s

# A non-root daemon needs raw protocol-88 sockets and Netlink route updates.
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
